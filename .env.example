NODE_ENV=production
DEPLOYMENT_MODE=self-hosted
AUTH_MODE=local
STORAGE_MODE=local
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data
SITE_HOST=quotes.example.com
PUBLIC_URL=https://quotes.example.com
WEB_URL=https://quotes.example.com
OWNER_EMAIL=admin@example.com
# Initial owner password (16-256 characters). Change it in Account after signing in.
INTERNAL_PASSWORD=
# Base64-encoded 32-byte key; keep a secure copy for restore.
TOKEN_ENCRYPTION_KEY=
# Local Web capacity. This does not grant official iOS licenses.
WEB_USER_LIMIT=10000
TURNSTILE_REQUIRED=false
# Production webhooks default to public HTTPS destinations with checked DNS.
# Set true only if this operator deliberately trusts tenant owners with LAN access:
# WEBHOOK_ALLOW_PRIVATE=false
# Optional customer-owned Turnstile, recommended for public forms:
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=quotes.example.com
# TURNSTILE_REQUIRED=true
# Optional SMTP; blank means no email will be sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=quotes@example.com
# SMTP_USER=quotes@example.com
# SMTP_PASS=
# Point to your corresponding source if you modify this AGPL server:
SOURCE_URL=https://github.com/dayellahk/dowi-quotes-community
